# Copy this file to .env and fill in your values

# PostgreSQL connection string
CHRONOS_DB_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chronos

# Rows to insert per DB batch (tune based on row size and available memory)
BATCH_SIZE=500

# Product sentinel value in source data that means "no product assigned"
NULL_PRODUCT_SENTINEL=NA

# Expected ratio of elapsed_time (hours) to man_day (days)
EXPECTED_HOURS_PER_DAY=8.0
RATIO_TOLERANCE=0.01

# Output directory for anomaly CSV files
ANOMALIES_OUTPUT_DIR=./output

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
